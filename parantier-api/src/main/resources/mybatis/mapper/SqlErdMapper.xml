<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.mapo.palantier.sql.infrastructure.SqlErdMapper">

    <resultMap id="SqlErdResultMap" type="com.mapo.palantier.sql.domain.SqlErd">
        <id property="id" column="id"/>
        <result property="title" column="title"/>
        <result property="content" column="content"/>
        <result property="description" column="description"/>
        <result property="orderNum" column="order_num"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <!-- 전체 ERD 목록 조회 (order_num ASC, created_at DESC) -->
    <select id="findAll" resultMap="SqlErdResultMap">
        SELECT id, title, content, description, order_num, created_at, updated_at
        FROM sql_erds
        ORDER BY order_num ASC, created_at DESC
    </select>

    <!-- ERD 항목 추가 -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sql_erds (title, content, description, order_num)
        VALUES (#{title}, #{content}, #{description}, #{orderNum})
    </insert>

    <!-- ERD 항목 수정 -->
    <update id="update">
        UPDATE sql_erds
        SET title       = #{title},
            content     = #{content},
            description = #{description},
            order_num   = #{orderNum},
            updated_at  = CURRENT_TIMESTAMP
        WHERE id = #{id}
    </update>

    <!-- ERD 항목 삭제 -->
    <delete id="delete">
        DELETE FROM sql_erds
        WHERE id = #{id}
    </delete>

</mapper>
