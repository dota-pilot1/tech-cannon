<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.mapo.palantier.work.infrastructure.WorkImageMapper">

    <resultMap id="WorkImageResultMap" type="com.mapo.palantier.work.domain.WorkImage">
        <id property="id" column="id"/>
        <result property="workId" column="work_id"/>
        <result property="url" column="url"/>
        <result property="filename" column="filename"/>
        <result property="fileType" column="file_type"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <!-- 특정 업무의 이미지 목록 조회 -->
    <select id="findByWorkId" resultMap="WorkImageResultMap">
        SELECT id, work_id, url, filename, file_type, created_at
        FROM work_images
        WHERE work_id = #{workId}
        ORDER BY created_at ASC
    </select>

    <!-- 이미지 추가 -->
    <insert id="insert" parameterType="com.mapo.palantier.work.domain.WorkImage"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO work_images (work_id, url, filename, file_type, created_at)
        VALUES (#{workId}, #{url}, #{filename}, #{fileType}, CURRENT_TIMESTAMP)
    </insert>

    <!-- 이미지 삭제 -->
    <delete id="delete">
        DELETE FROM work_images
        WHERE id = #{id}
    </delete>

</mapper>
