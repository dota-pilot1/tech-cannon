<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.mapo.palantier.issue.infrastructure.IssueDbTableMapper">

    <resultMap id="IssueDbTableResultMap" type="com.mapo.palantier.issue.domain.IssueDbTable">
        <id property="id" column="id"/>
        <result property="issueId" column="issue_id"/>
        <result property="tableName" column="table_name"/>
        <result property="tableInfo" column="table_info"/>
        <result property="orderNum" column="order_num"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="findByIssueId" resultMap="IssueDbTableResultMap">
        SELECT id, issue_id, table_name, table_info, order_num, created_at, updated_at
        FROM issue_dbtables
        WHERE issue_id = #{issueId}
        ORDER BY order_num ASC, created_at ASC
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO issue_dbtables (issue_id, table_name, table_info, order_num)
        VALUES (#{issueId}, #{tableName}, #{tableInfo}, #{orderNum})
    </insert>

    <update id="update">
        UPDATE issue_dbtables
        SET table_name = #{tableName},
            table_info = #{tableInfo},
            order_num = #{orderNum},
            updated_at = CURRENT_TIMESTAMP
        WHERE id = #{id}
    </update>

    <delete id="delete">
        DELETE FROM issue_dbtables
        WHERE id = #{id}
    </delete>

    <delete id="deleteByIssueId">
        DELETE FROM issue_dbtables
        WHERE issue_id = #{issueId}
    </delete>

</mapper>
