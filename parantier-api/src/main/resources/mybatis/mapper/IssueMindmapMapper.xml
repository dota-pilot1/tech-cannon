<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.mapo.palantier.issue.infrastructure.IssueMindmapMapper">

    <resultMap id="IssueMindmapResultMap" type="com.mapo.palantier.issue.domain.IssueMindmap">
        <id property="id" column="id"/>
        <result property="issueId" column="issue_id"/>
        <result property="title" column="title"/>
        <result property="content" column="content"/>
        <result property="orderNum" column="order_num"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <!-- 특정 이슈의 마인드맵 목록 조회 -->
    <select id="findByIssueId" resultMap="IssueMindmapResultMap">
        SELECT id, issue_id, title, content, order_num, created_at, updated_at
        FROM issue_mindmaps
        WHERE issue_id = #{issueId}
        ORDER BY order_num ASC, created_at ASC
    </select>

    <!-- 마인드맵 항목 추가 -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO issue_mindmaps (issue_id, title, content, order_num)
        VALUES (#{issueId}, #{title}, #{content}, #{orderNum})
    </insert>

    <!-- 마인드맵 항목 수정 -->
    <update id="update">
        UPDATE issue_mindmaps
        SET title = #{title},
            content = #{content},
            order_num = #{orderNum},
            updated_at = CURRENT_TIMESTAMP
        WHERE id = #{id}
    </update>

    <!-- 마인드맵 항목 삭제 -->
    <delete id="delete">
        DELETE FROM issue_mindmaps
        WHERE id = #{id}
    </delete>

    <!-- 이슈의 모든 마인드맵 삭제 -->
    <delete id="deleteByIssueId">
        DELETE FROM issue_mindmaps
        WHERE issue_id = #{issueId}
    </delete>

</mapper>
