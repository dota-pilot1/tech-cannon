<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.mapo.palantier.hackathon.infrastructure.HackathonIssueMapper">

    <resultMap id="HackathonTeamIssueResultMap" type="com.mapo.palantier.hackathon.domain.HackathonTeamIssue">
        <id property="id" column="id"/>
        <result property="teamId" column="team_id"/>
        <result property="title" column="title"/>
        <result property="content" column="content"/>
        <result property="status" column="status"/>
        <result property="priority" column="priority"/>
        <result property="assigneeId" column="assignee_id"/>
        <result property="assigneeName" column="assignee_name"/>
        <result property="createdBy" column="created_by"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <!-- 팀별 이슈 목록 조회 (담당자 이름 JOIN) -->
    <select id="findByTeamId" resultMap="HackathonTeamIssueResultMap">
        SELECT
            hi.id,
            hi.team_id,
            hi.title,
            hi.content,
            hi.status,
            hi.priority,
            hi.assignee_id,
            u.username AS assignee_name,
            hi.created_by,
            hi.created_at,
            hi.updated_at
        FROM hackathon_team_issues hi
        LEFT JOIN users u ON hi.assignee_id = u.id
        WHERE hi.team_id = #{teamId}
        ORDER BY hi.created_at DESC
    </select>

    <!-- 이슈 생성 -->
    <insert id="insert" parameterType="com.mapo.palantier.hackathon.domain.HackathonTeamIssue"
            useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO hackathon_team_issues (
            team_id,
            title,
            content,
            status,
            priority,
            assignee_id,
            created_by,
            created_at,
            updated_at
        ) VALUES (
            #{teamId},
            #{title},
            #{content},
            #{status},
            #{priority},
            #{assigneeId},
            #{createdBy},
            CURRENT_TIMESTAMP,
            CURRENT_TIMESTAMP
        )
    </insert>

    <!-- 이슈 수정 -->
    <update id="update" parameterType="com.mapo.palantier.hackathon.domain.HackathonTeamIssue">
        UPDATE hackathon_team_issues
        SET
            title       = #{title},
            content     = #{content},
            status      = #{status},
            priority    = #{priority},
            assignee_id = #{assigneeId},
            updated_at  = CURRENT_TIMESTAMP
        WHERE id = #{id}
    </update>

</mapper>
