<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.mapo.palantier.meeting.infrastructure.MeetingChannelMapper">

    <!-- MeetingChannel ResultMap -->
    <resultMap id="MeetingChannelResultMap" type="com.mapo.palantier.meeting.domain.MeetingChannel">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="slug" column="slug"/>
        <result property="orderNum" column="order_num"/>
        <result property="isActive" column="is_active"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <!-- 활성 채널 목록 조회 (order_num 오름차순) -->
    <select id="findAllActive" resultMap="MeetingChannelResultMap">
        SELECT
            id,
            name,
            slug,
            order_num,
            is_active,
            created_at
        FROM meeting_channels
        WHERE is_active = true
        ORDER BY order_num ASC
    </select>

</mapper>
