<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.mapo.palantier.hackathon.infrastructure.HackathonEventMapper">

    <resultMap id="HackathonEventResultMap" type="com.mapo.palantier.hackathon.domain.HackathonEvent">
        <id property="id" column="id"/>
        <result property="title" column="title"/>
        <result property="description" column="description"/>
        <result property="startAt" column="start_at"/>
        <result property="endAt" column="end_at"/>
        <result property="maxTeams" column="max_teams"/>
        <result property="isActive" column="is_active"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <!-- 활성 이벤트 단건 조회 -->
    <select id="findActive" resultMap="HackathonEventResultMap">
        SELECT *
        FROM hackathon_events
        WHERE is_active = true
        ORDER BY created_at DESC
        LIMIT 1
    </select>

    <!-- 전체 이벤트 목록 조회 -->
    <select id="findAll" resultMap="HackathonEventResultMap">
        SELECT *
        FROM hackathon_events
        ORDER BY created_at DESC
    </select>

    <!-- 이벤트 생성 -->
    <insert id="insert" parameterType="com.mapo.palantier.hackathon.domain.HackathonEvent"
            useGeneratedKeys="true" keyProperty="id,createdAt" keyColumn="id,created_at">
        INSERT INTO hackathon_events (
            title,
            description,
            start_at,
            end_at,
            max_teams,
            is_active,
            created_at
        ) VALUES (
            #{title},
            #{description},
            #{startAt},
            #{endAt},
            #{maxTeams},
            COALESCE(#{isActive}, true),
            CURRENT_TIMESTAMP
        )
    </insert>

    <!-- 이벤트 수정 -->
    <update id="update" parameterType="com.mapo.palantier.hackathon.domain.HackathonEvent">
        UPDATE hackathon_events
        SET
            title       = #{title},
            description = #{description},
            start_at    = #{startAt},
            end_at      = #{endAt},
            max_teams   = #{maxTeams},
            is_active   = #{isActive}
        WHERE id = #{id}
    </update>

</mapper>
