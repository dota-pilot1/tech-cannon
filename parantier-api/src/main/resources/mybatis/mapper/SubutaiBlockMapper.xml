<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.mapo.palantier.subutai.block.SubutaiBlockMapper">

    <resultMap id="SubutaiBlockResultMap" type="com.mapo.palantier.subutai.block.SubutaiBlock">
        <id property="id" column="id"/>
        <result property="postId" column="post_id"/>
        <result property="blockType" column="block_type" typeHandler="com.mapo.palantier.subutai.block.SubutaiBlockTypeHandler"/>
        <result property="blockTitle" column="block_title"/>
        <result property="content" column="content"/>
        <result property="sortOrder" column="sort_order"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="findByPostId" resultMap="SubutaiBlockResultMap">
        SELECT id, post_id, block_type, block_title, content, sort_order, created_at, updated_at
        FROM subutai_blocks
        WHERE post_id = #{postId}
        ORDER BY sort_order
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO subutai_blocks (post_id, block_type, block_title, content, sort_order)
        VALUES (#{postId}, #{blockType}, #{blockTitle}, #{content}, #{sortOrder})
    </insert>

    <delete id="deleteByPostId">
        DELETE FROM subutai_blocks WHERE post_id = #{postId}
    </delete>

</mapper>
