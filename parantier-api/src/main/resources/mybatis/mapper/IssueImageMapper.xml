<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.mapo.palantier.issue.infrastructure.IssueImageMapper">

    <resultMap id="IssueImageResultMap" type="com.mapo.palantier.issue.domain.IssueImage">
        <id property="id" column="id"/>
        <result property="issueId" column="issue_id"/>
        <result property="url" column="url"/>
        <result property="filename" column="filename"/>
        <result property="fileType" column="file_type"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <insert id="insert" parameterType="com.mapo.palantier.issue.domain.IssueImage" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO issue_images (issue_id, url, filename, file_type, created_at)
        VALUES (#{issueId}, #{url}, #{filename}, #{fileType}, CURRENT_TIMESTAMP)
    </insert>

    <select id="findByIssueId" resultMap="IssueImageResultMap">
        SELECT id, issue_id, url, filename, file_type, created_at
        FROM issue_images
        WHERE issue_id = #{issueId}
        ORDER BY created_at ASC
    </select>

    <delete id="deleteById">
        DELETE FROM issue_images
        WHERE id = #{id}
    </delete>

    <delete id="deleteByIssueId">
        DELETE FROM issue_images
        WHERE issue_id = #{issueId}
    </delete>

</mapper>
