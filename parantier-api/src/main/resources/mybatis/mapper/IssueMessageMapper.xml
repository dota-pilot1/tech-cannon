<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.mapo.palantier.issue.infrastructure.IssueMessageMapper">

    <!-- IssueMessage ResultMap -->
    <resultMap id="IssueMessageResultMap" type="com.mapo.palantier.issue.domain.IssueMessage">
        <id property="id" column="id"/>
        <result property="issueId" column="issue_id"/>
        <result property="userId" column="user_id"/>
        <result property="message" column="message"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
        <result property="isDeleted" column="is_deleted"/>
    </resultMap>

    <!-- MessageWithUser ResultMap (JOIN용) -->
    <resultMap id="MessageWithUserResultMap" type="com.mapo.palantier.issue.domain.MessageWithUser">
        <id property="id" column="id"/>
        <result property="issueId" column="issue_id"/>
        <result property="userId" column="user_id"/>
        <result property="message" column="message"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
        <result property="isDeleted" column="is_deleted"/>
        <result property="username" column="username"/>
        <result property="userEmail" column="user_email"/>
    </resultMap>

    <!-- 특정 이슈의 메시지 목록 조회 (작성자 정보 포함) -->
    <select id="findByIssueId" resultMap="MessageWithUserResultMap">
        SELECT
            im.id,
            im.issue_id,
            im.user_id,
            im.message,
            im.created_at,
            im.updated_at,
            im.is_deleted,
            u.username,
            u.email AS user_email
        FROM issue_messages im
        LEFT JOIN users u ON im.user_id = u.id
        WHERE im.issue_id = #{issueId}
          AND im.is_deleted = false
        ORDER BY im.created_at ASC
    </select>

    <!-- 메시지 ID로 단일 메시지 조회 -->
    <select id="findById" resultMap="IssueMessageResultMap">
        SELECT
            id,
            issue_id,
            user_id,
            message,
            created_at,
            updated_at,
            is_deleted
        FROM issue_messages
        WHERE id = #{id}
    </select>

    <!-- 메시지 생성 -->
    <insert id="insert" parameterType="com.mapo.palantier.issue.domain.IssueMessage"
            useGeneratedKeys="true" keyProperty="id,createdAt,updatedAt"
            keyColumn="id,created_at,updated_at">
        INSERT INTO issue_messages (
            issue_id,
            user_id,
            message,
            created_at,
            updated_at,
            is_deleted
        ) VALUES (
            #{issueId},
            #{userId},
            #{message},
            CURRENT_TIMESTAMP,
            CURRENT_TIMESTAMP,
            false
        )
    </insert>

    <!-- 메시지 수정 -->
    <update id="update" parameterType="com.mapo.palantier.issue.domain.IssueMessage">
        UPDATE issue_messages
        SET
            message = #{message},
            updated_at = CURRENT_TIMESTAMP
        WHERE id = #{id}
    </update>

    <!-- 메시지 삭제 (소프트 삭제) -->
    <update id="delete">
        UPDATE issue_messages
        SET
            is_deleted = true,
            updated_at = CURRENT_TIMESTAMP
        WHERE id = #{id}
    </update>

    <!-- 특정 이슈의 전체 메시지 개수 조회 -->
    <select id="countByIssueId" resultType="int">
        SELECT COUNT(*)
        FROM issue_messages
        WHERE issue_id = #{issueId}
          AND is_deleted = false
    </select>

</mapper>
