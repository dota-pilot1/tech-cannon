<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mapo.palantier.subutai.ai.infrastructure.SubutaiDocSectionMapper">
    <resultMap id="SecRM" type="com.mapo.palantier.subutai.ai.domain.SubutaiDocSection">
        <id property="id" column="id"/>
        <result property="postId" column="post_id"/>
        <result property="title" column="title"/>
        <result property="content" column="content"/>
        <result property="orderNum" column="order_num"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>
    <select id="findByPostId" resultMap="SecRM">SELECT id,post_id,title,content,order_num,created_at,updated_at FROM subutai_doc_sections WHERE post_id=#{postId} ORDER BY order_num,id</select>
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">INSERT INTO subutai_doc_sections(post_id,title,content,order_num) VALUES(#{postId},#{title},#{content},#{orderNum})</insert>
    <update id="update">UPDATE subutai_doc_sections SET title=#{title},content=#{content},order_num=#{orderNum},updated_at=CURRENT_TIMESTAMP WHERE id=#{id}</update>
    <delete id="delete">DELETE FROM subutai_doc_sections WHERE id=#{id}</delete>
    <delete id="deleteByPostId">DELETE FROM subutai_doc_sections WHERE post_id=#{postId}</delete>
</mapper>
