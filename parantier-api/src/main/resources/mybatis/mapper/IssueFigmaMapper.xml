<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.mapo.palantier.issue.infrastructure.IssueFigmaMapper">

    <resultMap id="IssueFigmaResultMap" type="com.mapo.palantier.issue.domain.IssueFigma">
        <id property="id" column="id"/>
        <result property="issueId" column="issue_id"/>
        <result property="title" column="title"/>
        <result property="url" column="url"/>
        <result property="description" column="description"/>
        <result property="orderNum" column="order_num"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="findByIssueId" resultMap="IssueFigmaResultMap">
        SELECT id, issue_id, title, url, description, order_num, created_at, updated_at
        FROM issue_figmas
        WHERE issue_id = #{issueId}
        ORDER BY order_num ASC, created_at ASC
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO issue_figmas (issue_id, title, url, description, order_num)
        VALUES (#{issueId}, #{title}, #{url}, #{description}, #{orderNum})
    </insert>

    <update id="update">
        UPDATE issue_figmas
        SET title       = #{title},
            url         = #{url},
            description = #{description},
            order_num   = #{orderNum},
            updated_at  = CURRENT_TIMESTAMP
        WHERE id = #{id}
    </update>

    <delete id="delete">
        DELETE FROM issue_figmas
        WHERE id = #{id}
    </delete>

    <delete id="deleteByIssueId">
        DELETE FROM issue_figmas
        WHERE issue_id = #{issueId}
    </delete>

</mapper>
