<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.mapo.palantier.pilot.infrastructure.PilotImageMapper">

    <resultMap id="PilotImageResultMap" type="com.mapo.palantier.pilot.domain.PilotImage">
        <id property="id" column="id"/>
        <result property="pilotId" column="pilot_id"/>
        <result property="url" column="url"/>
        <result property="filename" column="filename"/>
        <result property="fileType" column="file_type"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <select id="findByPilotId" resultMap="PilotImageResultMap">
        SELECT id, pilot_id, url, filename, file_type, created_at
        FROM pilot_images
        WHERE pilot_id = #{pilotId}
        ORDER BY created_at ASC
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO pilot_images (pilot_id, url, filename, file_type, created_at)
        VALUES (#{pilotId}, #{url}, #{filename}, #{fileType}, CURRENT_TIMESTAMP)
    </insert>

    <delete id="delete">
        DELETE FROM pilot_images WHERE id = #{id}
    </delete>

    <delete id="deleteByPilotId">
        DELETE FROM pilot_images WHERE pilot_id = #{pilotId}
    </delete>

</mapper>
