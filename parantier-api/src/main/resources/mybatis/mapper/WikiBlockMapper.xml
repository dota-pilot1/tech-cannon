<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.mapo.palantier.wiki.infrastructure.WikiBlockMapper">

    <resultMap id="WikiBlockResultMap" type="com.mapo.palantier.wiki.domain.WikiBlock">
        <id property="id" column="id"/>
        <result property="postId" column="post_id"/>
        <result property="blockType" column="block_type" typeHandler="org.apache.ibatis.type.EnumTypeHandler" javaType="com.mapo.palantier.wiki.domain.WikiBlockType"/>
        <result property="content" column="content"/>
        <result property="sortOrder" column="sort_order"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="findByPostId" resultMap="WikiBlockResultMap">
        SELECT id, post_id, block_type, content, sort_order, created_at, updated_at
        FROM wiki_blocks
        WHERE post_id = #{postId}
        ORDER BY sort_order
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO wiki_blocks (post_id, block_type, content, sort_order)
        VALUES (#{postId}, #{blockType}, #{content}, #{sortOrder})
    </insert>

    <delete id="deleteByPostId">
        DELETE FROM wiki_blocks WHERE post_id = #{postId}
    </delete>

</mapper>
