<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.mapo.palantier.study.infrastructure.StudyCommentMapper">

    <resultMap id="StudyCommentResultMap" type="com.mapo.palantier.study.domain.StudyComment">
        <id property="id" column="id"/>
        <result property="postId" column="post_id"/>
        <result property="authorId" column="author_id"/>
        <result property="authorName" column="author_name"/>
        <result property="content" column="content"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="findByPostId" resultMap="StudyCommentResultMap">
        SELECT c.id, c.post_id, c.author_id,
               u.username AS author_name,
               c.content, c.created_at, c.updated_at
        FROM study_comments c
        JOIN users u ON c.author_id = u.id
        WHERE c.post_id = #{postId}
        ORDER BY c.created_at ASC
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO study_comments (post_id, author_id, content)
        VALUES (#{postId}, #{authorId}, #{content})
    </insert>

    <delete id="delete">
        DELETE FROM study_comments WHERE id = #{id}
    </delete>

</mapper>
